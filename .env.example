# Copy this file to .env.local (local) or add the same names in
# Vercel → Project Settings → Environment Variables (production).
# Never commit real values. Redeploy after changing any of them.

# ── Required · server-only (never prefix with NEXT_PUBLIC_) ──────────────

# Telegram bot that receives booking requests.
# Token: @BotFather → /newbot. Chat id: add the bot to the group (or press Start
# in its chat), send /start, then read chat.id from
# https://api.telegram.org/bot<token>/getUpdates  (a group id starts with -100).
# While unset, every booking shows the error state.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# amoCRM: every booking is also created as a lead with a contact.
# Subdomain: the part before .amocrm.ru in the account URL (e.g. "derlux").
# Token: Settings → Integrations → Keys and access (long-lived token).
# While unset, no lead is created.
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=

# ── Optional · read at build time ─────────────────────────────────────────

# Public site URL once the clinic's own domain is attached
# (canonical, sitemap, JSON-LD). Falls back to the Vercel production domain.
# Example: https://derlux.uz
NEXT_PUBLIC_SITE_URL=

# Search Console / Yandex Webmaster «HTML tag» verification codes.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Analytics: Google Analytics measurement id (G-XXXXXXXXXX) and
# Yandex Metrika counter number. Nothing is rendered while unset.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
